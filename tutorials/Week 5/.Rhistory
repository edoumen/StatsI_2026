df <- read.csv("../../datasets/fictional_data.csv")
# Remove objects
rm(list=ls())
detachAllPackages()
# Load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# Load any necessary packages
lapply(c("readr", "ggplot2"),  pkgTest)
# Set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# Check working directory
getwd()
df <- read.csv("../../datasets/fictional_data.csv")
View(df)
# Create a scatter plot
ggplot(data = df, aes(x = income, y = edu)) +
geom_point()
plot(df$edu, df$income)
# Calculate correlation
cor(df$income, df$edu)
# Question: Is there a relationship between education and income?
# Model: income = b0 + b1 * education
# Save model as object
summary(lm(income ~ edu, data = df))
model <-(lm(income~edu, data=df))
wpolicy <- read.csv("https://raw.githubusercontent.com/kosukeimai/qss/master/PREDICTION/women.csv")
summary(wpolicy)
head(wpolicy)
tail(wpolicy)
model <- lm(water~reserved, data = wpolicy)
model
abline(model)
summary(model)
9.252/3.948
# Check p-value
sprintf("%.20f", 2.17e-06)
# Conduct t-test for the slope of a regression line
summary(model)
250.64/33.06
# Create a residual plot
model.res <- resid(model)
model.res
model.res <- resid(model)
model.res
print("-----")
model.res <- resid(model)
model.res
abline(0,0)
plot(wpolicy$reserved, model.res,
ylab = "Residuals",
xlab = "Reserved policy")
plot(wpolicy$reserved, model.res,
ylab = "Residuals",
xlab = "Reserved policy")
abline(0,0)
confint(model, level=0.99)
confint(model, level=0.95)
plot(x=wpolicy$reserved, y=wpolicy$water)
abline(model)
